{
  "name": "simple-dev-tools",
  "version": "2.0.2",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "assets:prepare": "node scripts/prepare-sqljs.mjs",
    "assets:brand": "bun scripts/brand-assets.mjs",
    "dev": "bun run assets:prepare && next dev",
    "build": "bun run assets:prepare && next build",
    "preview": "wrangler pages dev out --compatibility-date=2026-08-04",
    "lint": "oxlint && eslint .",
    "lint:fast": "oxlint",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "playwright test",
    "deps:check": "bunx knip",
    "deps:outdated": "bun outdated && bun audit",
    "check": "bun run audit && bun run lint && bun run typecheck && bun run test && bun run build",
    "audit": "bun scripts/dependency-audit.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6",
    "@codemirror/state": "6",
    "@codemirror/view": "6",
    "@lezer/highlight": "1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-virtual": "3.14.26",
    "@uiw/react-codemirror": "4.25.12",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.2",
    "cron-parser": "5.10.6",
    "cronstrue": "3.43.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "lucide-react": "1.75.0",
    "marked": "^18.2.1",
    "mermaid": "12.3.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.16.0",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "schema-dts": "2.1.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "katex": "0.18.2",
    "fast-glob": "npm:tinyglobby@0.2.17",
    "undici": "7.30.2"
  },
  "patchedDependencies": {
    "@next/eslint-plugin-next@16.4.6": "patches/@next%2Feslint-plugin-next@16.4.6.patch",
    "fdir@6.5.0": "patches/fdir@6.5.0.patch"
  }
}
